#!/usr/bin/python

import commands
import sys
import hashlib
import os
import sys

[status,returnString] = commands.getstatusoutput("snmpwalk -v3 -u nagios -n '' -l AuthPriv -a SHA -x AES -c public -A fo5Loogo -X fo5Loogo -m all " + sys.argv[1] + " ifOperStatus")

digest = hashlib.md5(returnString).hexdigest()
[catstatus, olddigest] = commands.getstatusoutput("cat /tmp/switchout")

def w(string):
    f = open("/tmp/switchout", "w")
    f.write(string)
    f.close()

if catstatus != 0:
    w(digest)
    print "I/O Issue"
    sys.exit(3)
elif status != 0:
    w(digest)
    print "SNMP problem"
    sys.exit(3)
elif digest == olddigest and olddigest != "":
    w(digest)
    print "OK"
    sys.exit(0)
else:
    w(digest)
    print "CRITICAL"
    sys.exit(2)



